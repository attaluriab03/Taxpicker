# ─── Supabase ───────────────────────────────────────────────────────────────
# Found in Supabase Dashboard → Project Settings → API

# Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Supabase secret key (server-side only — never expose to browser)
SUPABASE_SECRET_KEY=sb_secret_xxx

# ─── Anthropic API ──────────────────────────────────────────────────────────
# Found in console.anthropic.com → API Keys
# Used for AI auto-fill in the admin panel

ANTHROPIC_API_KEY=sk-ant-xxx

# ─── Site URLs ──────────────────────────────────────────────────────────────
# No trailing slash on any of these values.
#
# Production values:
#   NEXT_PUBLIC_SITE_URL=https://yourdomain.com
#   NEXT_PUBLIC_ADMIN_URL=https://admin.yourdomain.com
#   NEXT_PUBLIC_DOMAIN=yourdomain.com
#
# Local development values:
#   NEXT_PUBLIC_SITE_URL=http://localhost:3000
#   NEXT_PUBLIC_ADMIN_URL=http://localhost:3000/admin
#   NEXT_PUBLIC_DOMAIN=localhost:3000

# The public-facing website URL
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# The admin panel URL
NEXT_PUBLIC_ADMIN_URL=https://admin.yourdomain.com

# The root domain without protocol or www
NEXT_PUBLIC_DOMAIN=yourdomain.com
